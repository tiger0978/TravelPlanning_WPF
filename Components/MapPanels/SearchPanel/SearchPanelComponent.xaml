<UserControl
    x:Class="TravelPlanning.Components.MapPanels.SearchPanel.SearchPanelComponent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:comment="clr-namespace:TravelPlanning.Views.Pages.SearchPlace.Comment"
    xmlns:conv="clr-namespace:TravelPlanning.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TravelPlanning.Components.MapPanels.SearchPanel"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:overView="clr-namespace:TravelPlanning.Views.Pages.SearchPlace.OverView"
    xmlns:routes="clr-namespace:TravelPlanning.Components.MapPanels.PlanRoutePanel"
    xmlns:saveList="clr-namespace:TravelPlanning.Components.SaveList"
    xmlns:savedPlace="clr-namespace:TravelPlanning.Components.MapPanels.SavePlacePanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="450"
    d:DesignWidth="465"
    mc:Ignorable="d">

    <UserControl.Resources>
        <conv:StarConverter x:Key="StarConverter" />

        <Style x:Key="MapActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="BorderBrush" Value="#22000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Root"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#F5F5F5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EBEBEB" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TabRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#5F6368" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Root"
                            Padding="10,6"
                            Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#EEF3F8" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#1A73E8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FAFAFA">
        <Border CornerRadius="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!--  ═══ 頂部色塊（取代原本的 Image） ═══  -->
                    <Border
                        Height="300"
                        ClipToBounds="True"
                        CornerRadius="12,12,0,0">
                        <Grid>
                            <!--  背景圖  -->
                            <Image Source="{Binding Photo}" Stretch="Fill" />
                            <!--  漸層遮罩，讓文字清晰  -->
                            <Border>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="#00000000" />
                                        <GradientStop Offset="1" Color="#AA000000" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <!--  文字區塊  -->
                            <StackPanel Margin="16,0,16,14" VerticalAlignment="Bottom">
                                <!--  類型標籤  -->
                                <Border
                                    Margin="0,0,0,6"
                                    Padding="8,3"
                                    HorizontalAlignment="Left"
                                    Background="#44FFFFFF"
                                    CornerRadius="100">
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="White"
                                        Text="{Binding Type}" />
                                </Border>
                                <!--  地點名稱  -->
                                <TextBlock
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding PlaceName}" />
                                <!--  評分列  -->
                                <StackPanel
                                    Margin="0,4,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="White"
                                        Text="{Binding Rate}" />
                                    <ItemsControl ItemsSource="{Binding Stars}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="1"
                                                    FontSize="14"
                                                    Foreground="#FAC775"
                                                    Text="{Binding Converter={StaticResource StarConverter}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="16,16,16,0">

                        <!--  ═══ 操作按鈕列 ═══  -->
                        <StackPanel Margin="0,0,0,16" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Command="{Binding RoutePlanCommand}"
                                CommandParameter="{x:Type routes:PlanRouteComponent}"
                                Style="{StaticResource MapActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:SymbolIcon
                                        HorizontalAlignment="Center"
                                        FontSize="18"
                                        Symbol="Directions24" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#5F6368"
                                        Text="規劃路線" />
                                </StackPanel>
                            </Button>

                            <Button
                                Name="SavedButton"
                                Margin="0,0,8,0"
                                Command="{Binding ChangePageCommand}"
                                CommandParameter="{x:Type savedPlace:SavePlacePanelComponent}"
                                Style="{StaticResource MapActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <ui:SymbolIcon
                                        HorizontalAlignment="Center"
                                        FontSize="18"
                                        Symbol="Bookmark24" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#5F6368"
                                        Text="已儲存" />
                                </StackPanel>
                            </Button>

                            <!--  Popup 保持原位，綁定不動  -->
                            <Popup
                                x:Name="SavedPopup"
                                AllowsTransparency="True"
                                IsOpen="{Binding ShowPopup}"
                                Placement="Right"
                                PlacementTarget="{Binding ElementName=SavedButton}"
                                StaysOpen="False">
                                <Border
                                    Padding="16"
                                    Background="White"
                                    CornerRadius="8">
                                    <saveList:SaveListComponent SelectedItem="{Binding DataContext.SelectedItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </Border>
                            </Popup>
                        </StackPanel>

                        <!--  ═══ Tab 區域（原封不動） ═══  -->
                        <StackPanel Margin="0,10,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <RadioButton
                                    x:Name="TabOverview"
                                    Grid.Column="0"
                                    Checked="TabOverview_Checked"
                                    Command="{Binding ChangeTabCommand}"
                                    CommandParameter="{x:Type overView:OverViewPage}"
                                    Content="總覽"
                                    GroupName="Tabs"
                                    IsChecked="True"
                                    Style="{StaticResource TabRadioButtonStyle}" />
                                <RadioButton
                                    x:Name="TabComment"
                                    Grid.Column="1"
                                    Checked="TabComment_Checked"
                                    Command="{Binding ChangeTabCommand}"
                                    CommandParameter="{x:Type comment:CommentPage}"
                                    Content="評論"
                                    GroupName="Tabs"
                                    Style="{StaticResource TabRadioButtonStyle}" />
                                <!--  滑動底線  -->
                                <Border
                                    x:Name="SlidingIndicator"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Width="{Binding ActualWidth, ElementName=TabOverview}"
                                    Height="3"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    Background="#1A73E8">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="IndicatorTransform" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>

                            <!--  分隔線  -->
                            <Border
                                Height="1"
                                Margin="0,0,0,8"
                                Background="#E0E0E0" />

                            <!--  Tab Content  -->
                            <Grid>
                                <!--  總覽 Panel  -->
                                <StackPanel x:Name="OverviewPanel" Visibility="Visible">
                                    <Frame x:Name="Frame" Height="350" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>