<Page
    x:Class="TravelPlanning.Views.Pages.CreateTravels.CreateTravelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:local="clr-namespace:TravelPlanning.Views.Pages.CreateTravels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="CreateTravel"
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#121217" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="BorderBrush" Value="#2A2A30" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="#5A5AFF" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#3F3F46" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5A5AFF" />
                                <Setter TargetName="border" Property="Background" Value="#1A1A24" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="TitleTextBox"
            BasedOn="{StaticResource ModernTextBox}"
            TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="0,4" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border
                            x:Name="border"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,2">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#5A5AFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="Foreground" Value="#A1A1AA" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="AnimatedButton" TargetType="ui:Button">
            <Setter Property="Background" Value="#5A5AFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                To="#7A7AFF"
                                Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <ColorAnimation
                                Storyboard.TargetProperty="(Button.Background).(SolidColorBrush.Color)"
                                To="#5A5AFF"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Background="#09090B">

        <Ellipse
            Width="500"
            Height="500"
            Margin="0,-200,-200,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Fill="#5A5AFF"
            IsHitTestVisible="False"
            Opacity="0.05">
            <Ellipse.Effect>
                <BlurEffect Radius="150" />
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse
            Width="400"
            Height="400"
            Margin="-150,0,0,-150"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Fill="#FF5A5A"
            IsHitTestVisible="False"
            Opacity="0.03">
            <Ellipse.Effect>
                <BlurEffect Radius="150" />
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="850"
                Margin="24,24,24,24"
                HorizontalAlignment="Stretch">

                <Border
                    Height="300"
                    Margin="0,0,0,20"
                    Background="#121217"
                    BorderBrush="#2A2A30"
                    BorderThickness="1.5"
                    CornerRadius="12"
                    Cursor="Hand">
                    <i:Interaction.Triggers>
                        <i:EventTrigger EventName="MouseLeftButtonDown">
                            <i:InvokeCommandAction Command="{Binding SelectImageCommand}" />
                        </i:EventTrigger>
                    </i:Interaction.Triggers>

                    <Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border
                                Width="48"
                                Height="48"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Center"
                                Background="#1A1A24"
                                CornerRadius="24">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="22"
                                    Text="📸" />
                            </Border>
                            <TextBlock
                                Margin="0,0,0,4"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="#F4F4F5"
                                Text="點擊設定旅程封面" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="#71717A"
                                Text="建議上傳高畫質橫式圖片" />
                        </StackPanel>

                        <Border CornerRadius="10" IsHitTestVisible="False">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Cover}" Stretch="Fill" />
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Margin="0,0,0,20">
                    <Label
                        Margin="0,0,0,2"
                        Padding="0"
                        Content="TRAVEL TITLE"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="#5A5AFF" />
                    <TextBox Style="{StaticResource TitleTextBox}" Text="{Binding Title}" />
                </StackPanel>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <Label Content="📝 旅程描述與筆記" Style="{StaticResource ModernLabel}" />
                        <TextBox
                            Height="100"
                            VerticalContentAlignment="Top"
                            AcceptsReturn="True"
                            Text="{Binding Description}"
                            TextWrapping="Wrap"
                            VerticalScrollBarVisibility="Auto" />
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,0,0,24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Label Content="📅 預計天數" Style="{StaticResource ModernLabel}" />
                            <TextBox Height="40" Text="{Binding Days}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <Label Content="🗓️ 啟程日期" Style="{StaticResource ModernLabel}" />
                            <DatePicker
                                Height="45"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#F4F4F5"
                                SelectedDate="{Binding StartedDate}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <ui:Button
                    Height="44"
                    HorizontalAlignment="Stretch"
                    Command="{Binding CreateTravelCommand}"
                    CommandParameter="{Binding}"
                    Style="{StaticResource AnimatedButton}">
                    <ui:Button.RenderTransform>
                        <ScaleTransform CenterX="0" CenterY="0" ScaleX="1" ScaleY="1" />
                    </ui:Button.RenderTransform>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Text="🚀" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="Bold"
                            Text="建立旅遊計畫" />
                    </StackPanel>
                </ui:Button>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>