<Page
    x:Class="TravelPlanning.Views.Pages.SearchPlace.OverView.OverViewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:TravelPlanning.Views.Pages.SearchPlace.OverView"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:routes="clr-namespace:TravelPlanning.Components.MapPanels.PlanRoutePanel"
    xmlns:saveList="clr-namespace:TravelPlanning.Components.SaveList"
    xmlns:savedPlace="clr-namespace:TravelPlanning.Components.MapPanels.SavePlacePanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="OverViewPage"
    d:DesignHeight="450"
    d:DesignWidth="400"
    mc:Ignorable="d">



    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!--  資訊列表  -->
            <StackPanel Margin="10">

                <!--  地址  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        Background="#E6F1FB"
                        CornerRadius="16">
                        <ui:SymbolIcon
                            FontSize="15"
                            Foreground="#185FA5"
                            Symbol="Location24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            Foreground="Gray"
                            Text="地址" />
                        <TextBlock
                            FontSize="14"
                            Text="{Binding Addresses}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="0.5"
                    Margin="44,0,0,12"
                    Background="#22000000" />

                <!--  網站  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        Background="#E1F5EE"
                        CornerRadius="16">
                        <ui:SymbolIcon
                            FontSize="15"
                            Foreground="#0F6E56"
                            Symbol="Globe24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            Foreground="Gray"
                            Text="網站" />
                        <TextBlock
                            FontSize="14"
                            Text="{Binding WebSite}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="0.5"
                    Margin="44,0,0,12"
                    Background="#22000000" />

                <!--  電話  -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        Background="#FAEEDA"
                        CornerRadius="16">
                        <ui:SymbolIcon
                            FontSize="15"
                            Foreground="#BA7517"
                            Symbol="Call24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            Foreground="Gray"
                            Text="電話" />
                        <TextBlock
                            FontSize="14"
                            Text="{Binding Phone}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border
                    Height="0.5"
                    Margin="44,0,0,12"
                    Background="#22000000" />

                <!--  營業時間  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="32"
                        Height="32"
                        VerticalAlignment="Top"
                        Background="#FCEBEB"
                        CornerRadius="16">
                        <ui:SymbolIcon
                            FontSize="15"
                            Foreground="#A32D2D"
                            Symbol="Clock24" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="11"
                            Foreground="Gray"
                            Text="營業時間" />
                        <TextBlock
                            FontSize="14"
                            Text="{Binding OpeningTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

            </StackPanel>
        </StackPanel>
    </ScrollViewer>






