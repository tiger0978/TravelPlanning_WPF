<Page
    x:Class="TravelPlanning.Views.Pages.TravelPlanInfo.TravelPlanInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ac="clr-namespace:TravelPlanning.Components.AutoComplete"
    xmlns:convert="clr-namespace:TravelPlanning.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:GongSolutions.Wpf.DragDrop;assembly=GongSolutions.Wpf.DragDrop"
    xmlns:local="clr-namespace:TravelPlanning.Views.Pages.TravelPlanInfo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:time="clr-namespace:TravelPlanning.Helpers"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="TravelPlanInfoPage"
    d:DesignHeight="800"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <convert:TrafficWayConverter x:Key="TrafficWayConverter" />

        <Style x:Key="TimeHoverButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />

            <!--  🌟 修改這裡！把預設的 White 改成深色  -->
            <Setter Property="Foreground" Value="RoyalBlue" />

            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Padding="4,2" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <!--  滑鼠移過去時：變成粉紅色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FF4A7A" />
                            </Trigger>

                            <!--  彈窗打開時：保持粉紅色  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FF4A7A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <DropShadowEffect
            x:Key="DropShadowEffect"
            BlurRadius="15"
            Direction="270"
            Opacity="0.15"
            ShadowDepth="3"
            Color="Black" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Margin="0" Background="Transparent">
                            <StackPanel>
                                <ContentPresenter />
                                <Border
                                    Height="3"
                                    Margin="12,0,12,0"
                                    Background="#4D8EFF"
                                    CornerRadius="2"
                                    Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransportTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#E8437A" />
                                <Setter Property="BorderBrush" Value="#E8437A" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ════════════════════════════════════════
            左右箭頭圓形按鈕
            ════════════════════════════════════════
        -->
        <Style x:Key="NavCircleButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#666680" />
            <Setter Property="BorderBrush" Value="#E0E3EC" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F5FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#4D8EFF" />
                                <Setter Property="Foreground" Value="#4D8EFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0ECFF" />
                                <Setter TargetName="border" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform CenterX="15" CenterY="15" ScaleX="0.94" ScaleY="0.94" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.3" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ════════════════════════════════════════
            新增天數虛線圓形按鈕
            ════════════════════════════════════════
        -->
        <Style x:Key="AddDayButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AA0B8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="17">
                            <Border
                                x:Name="dashBorder"
                                BorderThickness="2"
                                CornerRadius="17">
                                <Border.BorderBrush>
                                    <DrawingBrush
                                        TileMode="Tile"
                                        Viewport="0,0,8,8"
                                        ViewportUnits="Absolute">
                                        <DrawingBrush.Drawing>
                                            <GeometryDrawing Brush="#C8D0E8">
                                                <GeometryDrawing.Geometry>
                                                    <LineGeometry StartPoint="0,0" EndPoint="8,0" />
                                                </GeometryDrawing.Geometry>
                                                <GeometryDrawing.Pen>
                                                    <Pen
                                                        Brush="#C8D0E8"
                                                        DashStyle="{x:Static DashStyles.Dash}"
                                                        Thickness="2" />
                                                </GeometryDrawing.Pen>
                                            </GeometryDrawing>
                                        </DrawingBrush.Drawing>
                                    </DrawingBrush>
                                </Border.BorderBrush>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#F0F5FF" />
                                <Setter Property="Foreground" Value="#4D8EFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E0ECFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ════════════════════════════════════════
            加入景點 / 飯店 / 門票 按鈕
            ════════════════════════════════════════
        -->
        <Style x:Key="AddActionButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#E8EAF0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Width" Value="70" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F5F8FF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4D8EFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#EAF0FF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ════════════════════════════════════════
            景點卡片樣式
            ════════════════════════════════════════
        -->
        <Style x:Key="SpotCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,0,10" />

            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                        BlurRadius="12"
                        Direction="270"
                        Opacity="0.06"
                        ShadowDepth="2"
                        Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <!--
        ════════════════════════════════════════════════════════════
        ROOT LAYOUT: 左右兩欄
        左欄 (400px) = 固定 Tab Header + 捲動景點內容
        右欄 (*) = 地圖
        ════════════════════════════════════════════════════════════
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
            ══════════════════════════════════════════════════════════
            左欄：使用 DockPanel 把 Tab Bar 固定在頂部
            DockPanel.LastChildFill="True" 讓 ScrollViewer 填滿剩餘空間
            ══════════════════════════════════════════════════════════
        -->
        <DockPanel Grid.Column="0" LastChildFill="True">

            <!--  ── 固定的 Day Tabs Header（DockPanel.Dock="Top"）──  -->
            <Border
                Padding="0,6,0,6"
                Background="White"
                BorderBrush="#EBEBF0"
                BorderThickness="0,0,0,1"
                DockPanel.Dock="Top">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="8"
                        Direction="270"
                        Opacity="0.05"
                        ShadowDepth="2"
                        Color="#000000" />
                </Border.Effect>

                <Grid Height="68">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="44" />
                    </Grid.ColumnDefinitions>

                    <!--  左箭頭  -->
                    <Button
                        Grid.Column="0"
                        Width="30"
                        Height="30"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Command="{Binding ScrollLeftCommand}"
                        Content="&#8249;"
                        FontSize="18"
                        Style="{StaticResource NavCircleButtonStyle}" />

                    <!--  Tab 捲動區  -->
                    <ScrollViewer
                        x:Name="TabScrollViewer"
                        Grid.Column="1"
                        Focusable="False"
                        HorizontalScrollBarVisibility="Visible"
                        VerticalScrollBarVisibility="Hidden">

                        <ListBox
                            dd:DragDrop.DropHandler="{Binding}"
                            dd:DragDrop.IsDragSource="True"
                            dd:DragDrop.IsDropTarget="True"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding Days}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectedItem="{Binding SelectedDay}">

                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Width="130"
                                        Height="52"
                                        Margin="4,6,4,8"
                                        Background="White"
                                        CornerRadius="14">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="10"
                                                Opacity="0.08"
                                                ShadowDepth="2" />
                                        </Border.Effect>

                                        <Grid>

                                            <Grid Margin="10,6,22,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    Grid.Column="0"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    Foreground="#BBBBCC"
                                                    Text="⇄" />

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontSize="13"
                                                        FontWeight="SemiBold"
                                                        Foreground="#2A2D3A"
                                                        Text="{Binding TravelDate}" />
                                                    <TextBlock
                                                        Margin="0,1,0,0"
                                                        FontSize="11"
                                                        Foreground="#9AA0B8"
                                                        Text="{Binding DayName}" />
                                                </StackPanel>
                                            </Grid>

                                            <Button
                                                Width="20"
                                                Height="20"
                                                Margin="0,4,4,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Command="{Binding DataContext.DeleteDayCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"
                                                Cursor="Hand"
                                                ToolTip="刪除">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border
                                                            x:Name="BtnBorder"
                                                            Background="Transparent"
                                                            CornerRadius="10">
                                                            <TextBlock
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center"
                                                                FontSize="10"
                                                                FontWeight="Bold"
                                                                Foreground="#FF8888"
                                                                Text="✕" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFF0F0" />
                                                            </Trigger>
                                                            <Trigger Property="IsPressed" Value="True">
                                                                <Setter TargetName="BtnBorder" Property="Background" Value="#FFE0E0" />
                                                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.8" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>

                    <!--  右箭頭  -->
                    <Button
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Command="{Binding ScrollRightCommand}"
                        Content="&#8250;"
                        FontSize="18"
                        Style="{StaticResource NavCircleButtonStyle}" />

                    <!--  新增天數  -->
                    <Button
                        Grid.Column="3"
                        Width="34"
                        Height="34"
                        Margin="4,0"
                        VerticalAlignment="Center"
                        Command="{Binding AddDayCommand}"
                        Content="+"
                        FontSize="20"
                        FontWeight="Light"
                        Style="{StaticResource AddDayButtonStyle}" />
                </Grid>
            </Border>

            <!--  ── 可捲動的景點內容區（自動填滿剩餘高度）──  -->
            <ScrollViewer
                Background="#F5F6FA"
                HorizontalScrollBarVisibility="Disabled"
                PanningMode="VerticalFirst"
                VerticalScrollBarVisibility="Auto">

                <!--  景點列表：ItemsControl bind 到 SelectedDay.Spots  -->

                <StackPanel Orientation="Vertical">

                    <Grid Margin="16,14,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="#4D8EFF"
                                Text="第一天" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="#9AA0B8"
                                Text="2025-08-01" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ToggleButton
                                x:Name="MyToggle"
                                Margin="0,0,8,0"
                                Style="{StaticResource AddActionButtonStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="22"
                                        Foreground="#4A4E6A"
                                        Text="＋" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="#6B7080"
                                        Text="加入景點" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>

                    <Border Visibility="{Binding IsChecked, ElementName=MyToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="70" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                Height="33"
                                Margin="20,5,20,5"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Top"
                                Panel.ZIndex="999"
                                Background="White"
                                BorderBrush="#DEE2E6"
                                BorderThickness="1"
                                CornerRadius="24">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="10"
                                        Opacity="0.2"
                                        ShadowDepth="2" />
                                </Border.Effect>
                                <Grid Margin="15,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--<Grid x:Name="PlaceContainer" Grid.Column="0" />-->
                                    <ac:AutoCompleteComponent Grid.Column="0" SelectedItemCommand="{Binding SelectItemCommand}" />
                                    <Button
                                        Grid.Column="1"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding ClearCommand}"
                                        Cursor="Hand">
                                        <ui:SymbolIcon Foreground="#70757A" Symbol="Dismiss24" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Border
                                Grid.Row="1"
                                Height="1"
                                Background="#E8EAF0" />

                        </Grid>
                    </Border>



                    <ItemsControl
                        x:Name="PlacesItemsControl"
                        Margin="16,16,16,8"
                        dd:DragDrop.DropHandler="{Binding}"
                        dd:DragDrop.IsDragSource="True"
                        dd:DragDrop.IsDropTarget="True"
                        AlternationCount="9999"
                        ItemsSource="{Binding CurrentPlaces}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,0">

                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter}, Path=(ItemsControl.AlternationIndex)}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Normal"
                                                Foreground="#CCCCCC"
                                                Text="{Binding PreviousLeavingTime}" />

                                            <Border
                                                Width="6"
                                                Height="6"
                                                Background="#4A90E2"
                                                CornerRadius="3" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="0,0,0,8"
                                            Orientation="Horizontal">

                                            <StackPanel Orientation="Horizontal">

                                                <RadioButton
                                                    Command="{Binding DataContext.ChangeTrafficWayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    IsChecked="{Binding TrafficMode, Converter={StaticResource TrafficWayConverter}, ConverterParameter=DRIVE}"
                                                    Style="{StaticResource TransportTabStyle}">
                                                    <ui:SymbolIcon
                                                        FontSize="18"
                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                                        Symbol="VehicleCab20" />
                                                </RadioButton>

                                                <RadioButton
                                                    Command="{Binding DataContext.ChangeTrafficWayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    IsChecked="{Binding TrafficMode, Converter={StaticResource TrafficWayConverter}, ConverterParameter=WALK}"
                                                    Style="{StaticResource TransportTabStyle}">
                                                    <ui:SymbolIcon
                                                        FontSize="18"
                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                                        Symbol="PersonWalking20" />
                                                </RadioButton>

                                                <RadioButton
                                                    Command="{Binding DataContext.ChangeTrafficWayCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                    CommandParameter="{Binding}"
                                                    IsChecked="{Binding TrafficMode, Converter={StaticResource TrafficWayConverter}, ConverterParameter=TRANSIT}"
                                                    Style="{StaticResource TransportTabStyle}">
                                                    <ui:SymbolIcon
                                                        FontSize="18"
                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=RadioButton}, Path=Foreground}"
                                                        Symbol="VehicleSubway20" />
                                                </RadioButton>

                                            </StackPanel>
                                            <TextBlock
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Medium"
                                                Foreground="#E8437A"
                                                Text="{Binding DisplayDrivingDuration}" />
                                        </StackPanel>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="54" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            Margin="0,12,0,0"
                                            VerticalAlignment="Top">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="White"
                                                Text="{Binding TravelTime}" />
                                            <Border
                                                Width="20"
                                                Height="20"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                Background="PaleVioletRed"
                                                CornerRadius="10" />
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="#C84F70"
                                                Text="自訂"
                                                Visibility="{Binding HasArrivedTime, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </StackPanel>

                                        <Border Grid.Column="1" Style="{StaticResource SpotCardStyle}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="62" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border
                                                        Grid.Column="0"
                                                        Width="75"
                                                        Height="75"
                                                        ClipToBounds="True"
                                                        CornerRadius="10">
                                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                                    </Border>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                        <TextBlock
                                                            FontSize="14"
                                                            FontWeight="Bold"
                                                            Foreground="#1E2030"
                                                            Text="{Binding Name}"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <ToggleButton
                                                            x:Name="TimeToggleButton"
                                                            Margin="-4,4,0,0"
                                                            HorizontalContentAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Cursor="Hand"
                                                            IsChecked="{Binding IsEditingTime}"
                                                            Style="{StaticResource TimeHoverButtonStyle}">
                                                            <TextBlock
                                                                Margin="0,0,0,0"
                                                                FontSize="12"
                                                                Text="{Binding Duration, StringFormat=停留 {0} 分鐘}" />
                                                        </ToggleButton>

                                                        <Popup
                                                            AllowsTransparency="True"
                                                            Cursor=""
                                                            IsOpen="{Binding IsChecked, ElementName=TimeToggleButton}"
                                                            Placement="Right"
                                                            PlacementTarget="{Binding ElementName=TimeToggleButton}"
                                                            PopupAnimation="Fade"
                                                            StaysOpen="False">

                                                            <Border
                                                                Margin="10"
                                                                Padding="20"
                                                                Background="White"
                                                                CornerRadius="8"
                                                                Effect="{StaticResource DropShadowEffect}">
                                                                <StackPanel Width="360">
                                                                    <TextBlock
                                                                        Margin="0,0,0,20"
                                                                        FontSize="18"
                                                                        FontWeight="Bold"
                                                                        Foreground="#1E2030"
                                                                        Text="{Binding Name}" />
                                                                    <CheckBox
                                                                        x:Name="CustomArrivalCheckBox"
                                                                        Margin="-10,0,0,10"
                                                                        VerticalContentAlignment="Center"
                                                                        IsChecked="{Binding HasArrivedTime}">
                                                                        <TextBlock
                                                                            Margin="4,0,0,0"
                                                                            FontSize="14"
                                                                            Foreground="#333333"
                                                                            Text="自訂抵達時間" />
                                                                    </CheckBox>
                                                                    <Grid Margin="0,0,0,20" IsEnabled="{Binding IsChecked, ElementName=CustomArrivalCheckBox}">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="1*" />
                                                                            <ColumnDefinition Width="8" />
                                                                            <ColumnDefinition Width="1.5*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="1.5*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <ComboBox
                                                                            Grid.Column="0"
                                                                            Padding="8,6"
                                                                            BorderBrush="black"
                                                                            FontSize="14"
                                                                            Foreground="#666666"
                                                                            ItemsSource="{x:Static time:TimeOptionsHelper.TimeOptions}"
                                                                            SelectedValue="{Binding ArrivalAmPm}" />
                                                                        <ComboBox
                                                                            Grid.Column="2"
                                                                            Padding="8,6"
                                                                            BorderBrush="black"
                                                                            FontSize="14"
                                                                            Foreground="#333333"
                                                                            ItemsSource="{x:Static time:TimeOptionsHelper.ArriveHours}"
                                                                            SelectedValue="{Binding ArrivalHour}" />
                                                                        <TextBlock
                                                                            Grid.Column="3"
                                                                            Margin="8,0"
                                                                            VerticalAlignment="Center"
                                                                            FontSize="16"
                                                                            FontWeight="Bold"
                                                                            Foreground="#333333"
                                                                            Text=":" />
                                                                        <ComboBox
                                                                            Grid.Column="4"
                                                                            Padding="8,6"
                                                                            BorderBrush="black"
                                                                            FontSize="14"
                                                                            Foreground="#333333"
                                                                            ItemsSource="{x:Static time:TimeOptionsHelper.ArriveMinutes}"
                                                                            SelectedValue="{Binding ArrivalMinute}" />
                                                                    </Grid>

                                                                    <TextBlock
                                                                        Margin="0,0,0,8"
                                                                        FontSize="14"
                                                                        Foreground="#333333"
                                                                        Text="停留時間" />

                                                                    <Grid Margin="0,0,0,24">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="1*" />
                                                                            <ColumnDefinition Width="8" />
                                                                            <ColumnDefinition Width="1*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <ComboBox
                                                                            Grid.Column="0"
                                                                            Padding="8,6"
                                                                            BorderBrush="black"
                                                                            FontSize="14"
                                                                            Foreground="#333333"
                                                                            ItemsSource="{x:Static time:TimeOptionsHelper.StayHours}"
                                                                            SelectedValue="{Binding StayHour}" />
                                                                        <ComboBox
                                                                            Grid.Column="2"
                                                                            Padding="8,6"
                                                                            BorderBrush="black"
                                                                            FontSize="14"
                                                                            Foreground="#333333"
                                                                            ItemsSource="{x:Static time:TimeOptionsHelper.StayMinutes}"
                                                                            SelectedValue="{Binding StayMinute}" />
                                                                    </Grid>

                                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                                        <Button
                                                                            Margin="0,0,12,0"
                                                                            Padding="16,8"
                                                                            Background="Transparent"
                                                                            BorderThickness="0"
                                                                            Command="{Binding DataContext.CancelEditTimeCommand, Source={x:Reference PlacesItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="取消"
                                                                            Cursor="Hand"
                                                                            FontSize="14"
                                                                            Foreground="#FF4A7A" />
                                                                        <Button
                                                                            Padding="20,8"
                                                                            Background="#FF4A7A"
                                                                            BorderThickness="0"
                                                                            Command="{Binding DataContext.SaveEditTimeCommand, Source={x:Reference PlacesItemsControl}}"
                                                                            CommandParameter="{Binding}"
                                                                            Content="完成"
                                                                            Cursor="Hand"
                                                                            FontSize="14"
                                                                            FontWeight="Bold"
                                                                            Foreground="White">
                                                                            <Button.Resources>
                                                                                <Style TargetType="Border">
                                                                                    <Setter Property="CornerRadius" Value="4" />
                                                                                </Style>
                                                                            </Button.Resources>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Border>
                                                        </Popup>
                                                        <TextBlock
                                                            Margin="0,5,0,0"
                                                            FontSize="12"
                                                            Foreground="#6B7080"
                                                            LineHeight="5"
                                                            Text="這是一個景點"
                                                            TextAlignment="Left"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="2"
                                                        Padding="4"
                                                        VerticalAlignment="Top"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="SpotMenuButton_Click"
                                                        Cursor="Hand">
                                                        <Button.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem
                                                                    Command="{Binding DataContext.DeleteSpotCommand, Source={x:Reference PlacesItemsControl}}"
                                                                    CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                    Header="🗑  刪除" />
                                                                <Separator />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                        <TextBlock
                                                            FontSize="13"
                                                            Foreground="#AAAABC"
                                                            Text="•••" />
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Height="40" />
                </StackPanel>

            </ScrollViewer>

        </DockPanel>

        <Grid
            Name="MapContainer"
            Grid.Column="1"
            Background="#EEF0F5" />

    </Grid>
</Page>
